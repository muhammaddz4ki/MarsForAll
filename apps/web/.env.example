# =============================================================================
# ARES-PATH: INTERPLANETARY SURVIVAL GUIDE (MARTIAN MAP)
# NASA Space Apps Challenge 2026 Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION & DEPLOYMENT
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="MARSFORALL"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# 2. PLANETARY GIS & TERRAIN TILESETS (JPL Mars Trek, USGS, HiRISE)
# -----------------------------------------------------------------------------
# JPL Mars Trek WMTS Endpoint for Gale Crater & Global Basemaps
# Keyless public scientific endpoint: https://trek.nasa.gov/mars/
NEXT_PUBLIC_MARS_TREK_WMTS_URL=https://api.nasa.gov/mars-wmts/catalog/Mars_Viking_MDIM21_ClrMosaic_global_232m/1.0.0/default/default028mm/{z}/{y}/{x}.jpg

# USGS Planetary Geologic Mapping Program Gale Crater Orthomosaic & 1m DEM DTM
NEXT_PUBLIC_USGS_MARS_DEM_TILES_URL=https://planetarymaps.usgs.gov/mosaic/Mars/HRSC_MOLA_Blend/HRSC_MOLA_Blend_global/{z}/{x}/{y}.png

# High-resolution (25 cm/px) HiRISE Mount Sharp Boxwork Overlay
NEXT_PUBLIC_HAKUTO_HIRISE_WMS_URL=https://hirise.lpl.arizona.edu/PDS/EXTRAS/RDR/ESP/ORB_037000_037999/ESP_037145_1755/

# -----------------------------------------------------------------------------
# 3. SPACE APPS 2026 GLOBAL PARTNER OFFERS (Cesium Ion & 3D Terrain)
# -----------------------------------------------------------------------------
# Cesium Ion Access Token for 3D Photogrammetric & Custom Mars Ellipsoid terrain tiles
# Obtain free hackathon token at: https://ion.cesium.com/
NEXT_PUBLIC_CESIUM_ION_ACCESS_TOKEN=your_cesium_ion_token_here

# -----------------------------------------------------------------------------
# 4. SPACE APPS 2026 GLOBAL PARTNER OFFERS (Firebase Realtime & Hosting)
# -----------------------------------------------------------------------------
# Firebase credentials for live astronaut visor HUD telemetry & mission team synchronization
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ares-martian-map.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ares-martian-map
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://ares-martian-map-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ares-martian-map.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# -----------------------------------------------------------------------------
# 5. TERRESTRIAL ANALOGUE GIS TELEMETRY (Overpass API & NASA Worldview GIBS)
# -----------------------------------------------------------------------------
# OpenStreetMap Overpass API for terrestrial testbed feature extraction (Atacama, Haughton, Death Valley, Rio Tinto)
NEXT_PUBLIC_OVERPASS_API_ENDPOINT=https://overpass-api.de/api/interpreter

# NASA GIBS (Global Imagery Browse Services) / Worldview Earthdata WMS
# Provides real-time and historical imagery for terrestrial analogue environments
NEXT_PUBLIC_NASA_GIBS_WMTS_ENDPOINT=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/wmts.cgi
NEXT_PUBLIC_EARTHDATA_BEARER_TOKEN=optional_earthdata_token

# NASA FIRMS Thermal Anomaly / Hotspot API Key (for thermal analogue calibrations)
NEXT_PUBLIC_FIRMS_MAP_KEY=optional_firms_map_key

# -----------------------------------------------------------------------------
# 6. MISSION OPERATIONAL CONSTRAINTS
# -----------------------------------------------------------------------------
# Default Target Site: Mount Sharp (Aeolis Mons), Gale Crater
NEXT_PUBLIC_DEFAULT_TARGET_LAT=-5.4453
NEXT_PUBLIC_DEFAULT_TARGET_LON=137.8414
NEXT_PUBLIC_DEFAULT_TARGET_NAME="Mount Sharp Boxwork 2025"

# Zero NASA Insignia Policy Verification Flag
NEXT_PUBLIC_STRICT_NO_NASA_LOGO=true
