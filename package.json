{
  "name": "marsforall",
  "private": true,
  "version": "0.1.0",
  "description": "MARSFORALL: Interplanetary Survival Guide - Martian Map (NASA Space Apps Challenge 2026)",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build --filter=@marsforall/web",
    "dev": "pnpm --filter @marsforall/web dev",
    "dev:web": "pnpm --filter @marsforall/web dev",
    "dev:all": "turbo run dev",
    "lint": "pnpm --filter @marsforall/web lint",
    "typecheck": "pnpm --filter @marsforall/web typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}